---
import Layout from '@/layouts/Layout.astro';
import TourCard from '@/components/TourCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import { getFeaturedTours, CATEGORIES } from '@/data/tours';
import { resolveImage, LOCAL_GALLERY_POOL, humanizeImageKey } from '@/data/images';
import { testimonials } from '@/data/testimonials';
import { getWhatsAppURL } from '@/utils/whatsapp';

const featuredTours = getFeaturedTours();
const waURL = getWhatsAppURL();
const heroImg = 'https://static.wixstatic.com/media/6350f4_9137f1937a364c0da3f36e8b99d76d71~mv2.jpg';

// Full rotating pool — every real tour photo in /public/images, each kept at
// its own native aspect ratio (no forced crop). The client swaps the 4 shown
// cards for a fresh random draw from this pool every ~10-15s.
const galleryPool = LOCAL_GALLERY_POOL.map(img => ({
  key: img.key,
  width: img.width,
  height: img.height,
  ar: img.width / img.height,
  src: resolveImage(img.key, img.width),
  alt: humanizeImageKey(img.key),
}));

const initialKeys = ['isla-saona', 'free-walking-tour', 'cayo-levantado', 'salto-limon'];
const galleryImages = initialKeys.map(key => galleryPool.find(img => img.key === key)!);
---

<Layout
  title="Tours y Excursiones en Santo Domingo"
  description="Pioneros del FREE Walking Tour en República Dominicana. Guías locales expertos, ecoturismo y aventura. Reserva online con confirmación instantánea."
  canonical="/"
>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="hero" style={`--hero-bg: url('${heroImg}')`}>
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      <div class="hero__logo">
        <img src="/logo.jpg" alt="Kayoe Excursiones" width="88" height="88" />
      </div>
      <span class="hero__eyebrow"><i class="ph-fill ph-star" aria-hidden="true"></i> Pioneros del FREE Tour en RD · Desde 2020</span>
      <h1 class="hero__title">Descubre Santo Domingo<br />con guías locales de verdad</h1>
      <p class="hero__subtitle">
        Free walking tours, ecoturismo y aventura.<br />
        Reserva en 2 minutos, paga después.
      </p>

      <!-- Search bar -->
      <form class="hero__search" action="/excursiones" method="get">
        <div class="hero__search-field">
          <label for="hero-q">¿Qué buscas?</label>
          <input type="text" id="hero-q" name="q" placeholder="Ej: Ciudad Colonial, Isla Saona..." />
        </div>
        <div class="hero__search-field">
          <label for="hero-cat">Categoría</label>
          <select id="hero-cat" name="categoria">
            <option value="">Todas</option>
            {Object.entries(CATEGORIES).map(([key, cat]) => (
              <option value={key}>{cat.label_es}</option>
            ))}
          </select>
        </div>
        <button type="submit" class="btn btn--primary btn--lg">
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i> Buscar tours
        </button>
      </form>

      <!-- Trust badges -->
      <div class="hero__trust">
        <span><i class="ph-fill ph-star icon" aria-hidden="true"></i> 4.9 TripAdvisor</span>
        <span><i class="ph ph-check icon" aria-hidden="true"></i> Cancelación gratis 24h</span>
        <span><i class="ph ph-check icon" aria-hidden="true"></i> Confirmación instantánea</span>
      </div>

      <!-- Secondary CTAs -->
      <div class="hero__ctas">
        <a href="/excursiones" class="btn btn--primary btn--lg">Ver todos los tours</a>
        <a href={waURL} target="_blank" rel="noopener" class="btn btn--outline-white btn--lg">
          <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       GALERÍA
  ══════════════════════════════════════════ -->
  <section class="section section--sm gallery-section">
    <div class="container">
      <div class="gallery-row" id="galleryRow">
        {galleryImages.map((img, i) => (
          <div class="gallery-card" data-key={img.key} style={`--ar: ${img.ar}`}>
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script define:vars={{ galleryPool }}>
    const row = document.getElementById('galleryRow');
    const cards = row ? Array.from(row.querySelectorAll('.gallery-card')) : [];

    function shuffle(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function nextDraw(exclude) {
      const rest = galleryPool.filter(img => !exclude.has(img.key));
      const source = rest.length >= cards.length ? rest : galleryPool;
      return shuffle(source).slice(0, cards.length);
    }

    function swap() {
      const shown = new Set(cards.map(c => c.dataset.key));
      const draw = nextDraw(shown);

      cards.forEach((card, i) => {
        const data = draw[i];
        if (!data) return;
        const preload = new Image();
        preload.onload = () => {
          card.classList.add('is-fading');
          setTimeout(() => {
            const img = card.querySelector('img');
            img.src = data.src;
            img.alt = data.alt;
            img.width = data.width;
            img.height = data.height;
            card.dataset.key = data.key;
            card.style.setProperty('--ar', String(data.ar));
            card.classList.remove('is-fading');
          }, 350);
        };
        preload.src = data.src;
      });
    }

    function loop() {
      setTimeout(() => { swap(); loop(); }, 10000 + Math.random() * 5000);
    }

    if (cards.length && galleryPool.length > cards.length) loop();
  </script>

  <!-- ══════════════════════════════════════════
       TOURS MÁS RESERVADOS
  ══════════════════════════════════════════ -->
  <section class="section featured">
    <div class="container">
      <div class="section-header">
        <h2>Nuestros tours más reservados</h2>
        <p>Experiencias auténticas con guías locales expertos que conocen cada rincón</p>
      </div>

      <!-- Category filter pills -->
      <div class="filter-pills" id="filterPills">
        <button class="filter-pill is-active" data-cat="all">Todos</button>
        <button class="filter-pill" data-cat="city-tours">City Tours</button>
        <button class="filter-pill" data-cat="ecoturismo">Ecoturismo</button>
        <button class="filter-pill" data-cat="aventura">Aventura</button>
      </div>

      <!-- Tour grid -->
      <div class="grid-3" id="featuredGrid">
        {featuredTours.map(tour => (
          <TourCard tour={tour} />
        ))}
      </div>

      <div class="featured__footer">
        <a href="/excursiones" class="btn btn--outline-primary btn--lg">
          Ver todos los tours →
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       ¿POR QUÉ KAYOE?
  ══════════════════════════════════════════ -->
  <section class="section section--sm why-section">
    <div class="container">
      <div class="section-header">
        <h2>¿Por qué viajar con Kayoe?</h2>
      </div>
      <div class="grid-4 why-grid">
        <div class="why-card">
          <div class="why-card__icon"><i class="ph ph-user" aria-hidden="true"></i></div>
          <h4>Guías locales</h4>
          <p>Expertos que conocen cada rincón, historia y secreto de Santo Domingo</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon"><i class="ph ph-trophy" aria-hidden="true"></i></div>
          <h4>Pioneros free tour</h4>
          <p>Los primeros en la República Dominicana en ofrecer free walking tours desde 2020</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon"><i class="ph ph-users-three" aria-hidden="true"></i></div>
          <h4>Grupos reducidos</h4>
          <p>Máximo 6 personas por tour. Atención personalizada, no masas de turistas</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon"><i class="ph ph-calendar-check" aria-hidden="true"></i></div>
          <h4>Reserva flexible</h4>
          <p>Cancela gratis hasta 24 horas antes. Sin riesgo, sin complicaciones</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       EXPLORA POR TIPO
  ══════════════════════════════════════════ -->
  <section class="section explore-section">
    <div class="container">
      <div class="section-header">
        <h2>Explora por tipo de experiencia</h2>
        <p>60+ experiencias en Santo Domingo y todo el país</p>
      </div>
      <div class="explore-grid">
        <a href="/excursiones?categoria=city-tours" class="explore-card" style={`--bg: url('${resolveImage('explore-city-tours', 800)}')`}>
          <div class="explore-card__overlay"></div>
          <div class="explore-card__content">
            <h3>City Tours</h3>
            <p>11 experiencias · Ciudad Colonial</p>
          </div>
        </a>
        <a href="/excursiones?categoria=ecoturismo" class="explore-card" style={`--bg: url('${resolveImage('explore-ecoturismo', 800)}')`}>
          <div class="explore-card__overlay"></div>
          <div class="explore-card__content">
            <h3>Ecoturismo</h3>
            <p>13 experiencias · Naturaleza e islas</p>
          </div>
        </a>
        <a href="/excursiones?categoria=aventura" class="explore-card" style={`--bg: url('${resolveImage('explore-aventura', 800)}')`}>
          <div class="explore-card__overlay"></div>
          <div class="explore-card__content">
            <h3>Aventura</h3>
            <p>2 experiencias · Punta Cana</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       TESTIMONIOS
  ══════════════════════════════════════════ -->
  <section class="section testimonios-section">
    <div class="container">
      <div class="section-header">
        <h2>Lo que dicen nuestros viajeros</h2>
        <p>300+ reseñas verificadas en TripAdvisor y Google</p>
      </div>
      <div class="grid-3">
        {testimonials.map(t => <TestimonialCard testimonial={t} />)}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       CTA FINAL
  ══════════════════════════════════════════ -->
  <section class="cta-final">
    <div class="container cta-final__inner">
      <h2>¿Listo para descubrir Santo Domingo?</h2>
      <p>Reserva en minutos. Cancela gratis. Guías locales de verdad.</p>
      <div class="cta-final__buttons">
        <a href={waURL} target="_blank" rel="noopener" class="btn btn--whatsapp btn--lg">
          <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> WhatsApp
        </a>
        <a href="/excursiones" class="btn btn--primary btn--lg">
          Ver todos los tours →
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ── */
.hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  background: var(--hero-bg, var(--primary)) center / cover no-repeat;
  color: #fff;
}
.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(27,58,92,.82) 40%, rgba(27,58,92,.55));
}
.hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.25rem;
  padding-block: 4rem;
  max-width: 780px;
}

.hero__logo {
  width: 88px;
  height: 88px;
  border-radius: var(--radius-full);
  background: #fff;
  box-shadow: 0 4px 20px rgba(0,0,0,.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 6px;
}
.hero__logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.hero__eyebrow {
  display: inline-block;
  background: rgba(245,166,35,.2);
  border: 1px solid rgba(245,166,35,.4);
  color: var(--accent);
  font-size: .82rem;
  font-weight: 700;
  padding: .35rem .9rem;
  border-radius: var(--radius-full);
  letter-spacing: .03em;
}

.hero__title {
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  text-shadow: 0 2px 12px rgba(0,0,0,.3);
}

.hero__subtitle {
  font-size: 1.1rem;
  color: rgba(255,255,255,.88);
  line-height: 1.5;
}

/* Search bar */
.hero__search {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  background: rgba(255,255,255,.12);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  width: 100%;
  max-width: 680px;
}
@media (min-width: 640px) {
  .hero__search { flex-direction: row; align-items: flex-end; gap: .75rem; }
}

.hero__search-field {
  display: flex;
  flex-direction: column;
  gap: .35rem;
  flex: 1;
}
.hero__search-field label {
  font-size: .78rem;
  font-weight: 600;
  color: rgba(255,255,255,.8);
  margin: 0;
}
.hero__search-field input,
.hero__search-field select {
  background: rgba(255,255,255,.92);
  border: none;
  border-radius: var(--radius-sm);
  padding: .65rem 1rem;
  font-size: .9rem;
}

/* Trust badges */
.hero__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
.hero__trust span {
  font-size: .82rem;
  color: rgba(255,255,255,.85);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: .25rem;
}

.hero__ctas { display: flex; flex-wrap: wrap; gap: .75rem; }

/* ── Gallery ── */
.gallery-section { background: #fff; }

/* Mobile: fixed-height horizontal scroll-snap strip. Each card keeps its
   photo's native aspect ratio (width auto-derives from height). */
.gallery-row {
  display: flex;
  gap: .75rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: 1rem;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.gallery-row::-webkit-scrollbar { display: none; }

.gallery-card {
  position: relative;
  flex: 0 0 auto;
  height: 220px;
  aspect-ratio: var(--ar);
  border-radius: var(--radius-md);
  overflow: hidden;
  scroll-snap-align: start;
  box-shadow: var(--shadow-sm);
  transition: opacity .35s ease;
}
.gallery-card.is-fading { opacity: 0; }

.gallery-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Desktop: justified row — flex-grow equal to each photo's own aspect
   ratio makes every card resolve to the same height while the row fills
   the container exactly, with zero cropping. Kicks in at the same
   breakpoint as the rest of the page's multi-column grids so cards never
   get squeezed too narrow for their labels. */
@media (min-width: 1024px) {
  .gallery-row { overflow-x: visible; }
  .gallery-card {
    height: auto;
    flex: var(--ar) 0 0;
    min-width: 0;
  }
}

/* ── Featured ── */
.featured { background: var(--bg-light); }

.filter-pills {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  margin-bottom: 2rem;
  justify-content: center;
}
.filter-pill {
  padding: .5rem 1.25rem;
  border-radius: var(--radius-full);
  border: 1.5px solid var(--border);
  background: #fff;
  font-size: .875rem;
  font-weight: 500;
  color: var(--text-muted);
  transition: all var(--transition);
  cursor: pointer;
}
.filter-pill:hover { border-color: var(--primary); color: var(--primary); }
.filter-pill.is-active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.featured__footer { text-align: center; margin-top: 2.5rem; }

/* ── Why section ── */
.why-section { background: #fff; }
.why-card {
  text-align: center;
  padding: 1.75rem 1.25rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
  transition: box-shadow var(--transition);
}
.why-card:hover { box-shadow: var(--shadow-md); }
.why-card__icon { font-size: 2.25rem; margin-bottom: .75rem; display: flex; justify-content: center; color: var(--accent); }
.why-card h4 { margin-bottom: .4rem; color: var(--primary); }
.why-card p  { font-size: .875rem; color: var(--text-muted); line-height: 1.6; }

/* ── Explore ── */
.explore-section { background: var(--bg-light); }
.explore-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}
@media (min-width: 640px)  { .explore-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .explore-grid { grid-template-columns: repeat(3, 1fr); } }

.explore-card {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--bg, var(--primary)) center / cover no-repeat;
  display: flex;
  align-items: flex-end;
  text-decoration: none;
}
.explore-card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.75) 0%, transparent 55%);
  transition: opacity .2s;
}
.explore-card:hover .explore-card__overlay { opacity: 1.3; }

.explore-card__content {
  position: relative;
  z-index: 1;
  padding: 1.5rem;
  color: #fff;
}
.explore-card__content h3 { font-size: 1.35rem; margin-bottom: .25rem; color: #fff; }
.explore-card__content p  { font-size: .82rem; opacity: .85; }

/* ── Testimonials ── */
.testimonios-section { background: #fff; }

/* ── CTA Final ── */
.cta-final {
  background: var(--primary);
  padding-block: 4.5rem;
  color: #fff;
}
.cta-final__inner {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}
.cta-final__inner h2 { color: #fff; font-size: clamp(1.5rem, 3vw, 2.2rem); }
.cta-final__inner p  { color: rgba(255,255,255,.8); max-width: 500px; }
.cta-final__buttons  { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; }
</style>
