---
import Layout from '@/layouts/Layout.astro';
import { tours, getTourBySlug, formatPrice, tourImageUrl, CATEGORIES } from '@/data/tours';
import TourGallery from '@/components/TourGallery.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return tours.map(tour => ({
    params: { slug: tour.slug },
    props:  { tour },
  }));
};

const { tour } = Astro.props;

if (!tour) return Astro.redirect('/excursiones');

const price   = formatPrice(tour);
const isQuote = tour.price_type === 'quote';
const isFree  = tour.price_type === 'free-tip';
const isGroup = tour.price_type === 'group';
const hasMinPrice = isQuote && price !== 'Cotizar';

// The variant tabs (below) update these hrefs live as the visitor switches
// between bookable options, so "Reservar ahora" always carries whichever
// variant is currently on screen through to /reservar. The first tab (index
// 0) is always the one active on page load, so the initial href must match
// that specific variant -- not just any bookable one -- when it has a real
// price.
const bookingBaseHref = `/reservar?tour=${tour.slug}`;
const activeVariant = tour.variants?.[0];
const initialBookingHref = (activeVariant?.price_type === 'fixed' || activeVariant?.price_type === 'from')
  ? `${bookingBaseHref}&variant=${activeVariant.id}`
  : bookingBaseHref;
const heroImg = tourImageUrl(tour.image, 1200, 600);
const galleryKeys = tour.gallery && tour.gallery.length > 0 ? tour.gallery : [tour.image];
const galleryImages = galleryKeys.map(key => ({
  thumb: tourImageUrl(key, 400),
  full:  tourImageUrl(key, 1400),
}));
const catLabel = CATEGORIES[tour.category]?.label_es;

// Trims to a max length at the last whole word so meta descriptions never
// cut off mid-word.
function truncateAtWord(text: string, maxLength: number): string {
  if (text.length <= maxLength) return text;
  const cut = text.slice(0, maxLength);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : maxLength)}…`;
}

const metaDescription = tour.description_es
  ? truncateAtWord(tour.description_es.replace(/\n/g, ' '), 155)
  : `${tour.name_es} en ${tour.location}. Kayoe Excursiones — guías locales expertos.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: tour.name_es,
  description: tour.description_es?.replace(/\n/g, ' ') ?? '',
  url: `https://kayoeexcursiones.com/excursiones/${tour.slug}`,
  image: heroImg,
  touristType: catLabel,
  offers: {
    '@type': 'Offer',
    price: tour.price_usd ?? 0,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  provider: {
    '@type': 'TouristInformationCenter',
    name: 'Kayoe Excursiones',
    url: 'https://kayoeexcursiones.com',
  },
};
---

<Layout
  title={`${tour.name_es} — ${tour.location}`}
  description={metaDescription}
  image={heroImg}
  canonical={`/excursiones/${tour.slug}`}
>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <div class="tour-hero" style={`background-image:url('${heroImg}')`}>
    <div class="tour-hero__overlay"></div>
    <div class="container tour-hero__content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <a href="/excursiones">Excursiones</a>
        <span>›</span>
        <span>{tour.name_es}</span>
      </nav>
      <h1 class="tour-hero__title">{tour.name_es}</h1>
      {tour.rating && (
        <div class="tour-hero__rating">
          <span class="stars" style="font-size:1rem">
            {Array.from({ length: Math.round(tour.rating) }).map(() => (
              <i class="ph-fill ph-star" aria-hidden="true"></i>
            ))}
          </span>
          <span style="color:rgba(255,255,255,.85);font-size:.9rem">{tour.rating} ({tour.review_count} reseñas)</span>
        </div>
      )}
    </div>
  </div>

  <!-- Content -->
  <div class="section">
    <div class="container tour-layout">

      <!-- Left: Details -->
      <div class="tour-details">

        <!-- Meta -->
        <div class="tour-meta-grid">
          {tour.location && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-map-pin icon" aria-hidden="true"></i> Ubicación</span>
              <span>{tour.location}</span>
            </div>
          )}
          {tour.duration && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-clock icon" aria-hidden="true"></i> Duración</span>
              <span>{tour.duration}</span>
            </div>
          )}
          {tour.languages && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-translate icon" aria-hidden="true"></i> Idiomas</span>
              <span>{tour.languages}</span>
            </div>
          )}
          {tour.schedule && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-calendar-dots icon" aria-hidden="true"></i> Horarios</span>
              <span>{tour.schedule}</span>
            </div>
          )}
          {tour.meeting_point && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-map-trifold icon" aria-hidden="true"></i> Punto de encuentro</span>
              <span>{tour.meeting_point}</span>
            </div>
          )}
          {tour.min_persons && (
            <div class="tour-meta-item">
              <span class="tour-meta-item__label"><i class="ph ph-users-three icon" aria-hidden="true"></i> Mínimo personas</span>
              <span>{tour.min_persons}</span>
            </div>
          )}
        </div>

        <!-- Description -->
        {tour.description_es && (
          <div class="tour-section">
            <h2>Descripción</h2>
            {tour.description_es.split('\n\n').map(para => (
              <p>{para}</p>
            ))}
          </div>
        )}

        <!-- Variants / Options -->
        {tour.variants && tour.variants.length > 0 && (
          <div class="tour-section tour-variants">
            <h2>Elige tu experiencia</h2>
            <div class="variant-tabs" role="tablist">
              {tour.variants.map((v, i) => (
                <button
                  class={`variant-tab${i === 0 ? ' is-active' : ''}`}
                  role="tab"
                  data-variant={v.id}
                  data-price-usd={(v.price_type === 'fixed' || v.price_type === 'from') ? v.price_usd : undefined}
                  data-price-child={(v.price_type === 'fixed' || v.price_type === 'from') ? v.price_child : undefined}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  type="button"
                >
                  {v.badge && <span class={`badge badge--${v.badge}`}>{v.badge}</span>}
                  {v.label}
                </button>
              ))}
            </div>
            {tour.variants.map((v, i) => (
              <div
                class={`variant-panel${i === 0 ? ' is-active' : ''}`}
                data-panel={v.id}
                role="tabpanel"
              >
                {v.location && <p class="variant-location">{v.location}</p>}
                {v.description_es && v.description_es.split('\n\n').map(para => (
                  <p>{para}</p>
                ))}
                {v.price_type === 'fixed' && v.price_usd && (
                  <p class="variant-price">
                    Precio: <strong>${v.price_usd} USD</strong> por persona
                    {v.price_child !== undefined && <> · {v.price_child_label ?? 'Niños'}: <strong>${v.price_child}</strong></>}
                    {v.price_infant_free && <> · Infantes: <strong>GRATIS</strong></>}
                  </p>
                )}
                {(v.price_type === 'from') && v.price_usd && (
                  <p class="variant-price">Desde <strong>${v.price_usd} USD</strong> por persona</p>
                )}
                {v.price_type === 'group' && v.price_groups && (
                  <div class="variant-group-table">
                    {v.price_groups.map(g => (
                      <div class="variant-group-row">
                        <span>Hasta {g.persons} personas</span>
                        <strong>${g.price_usd}</strong>
                      </div>
                    ))}
                  </div>
                )}
                {v.price_type === 'quote' && (
                  <a href={`/reservar?tour=${tour.slug}`} class="btn btn--primary btn--sm variant-quote-cta">
                    Cotizar esta opción
                  </a>
                )}
                {v.min_persons && (
                  <p class="variant-note">Mínimo {v.min_persons} personas</p>
                )}
              </div>
            ))}
          </div>
        )}

        <!-- Itinerary -->
        {tour.itinerary && tour.itinerary.length > 0 && (
          <div class="tour-section">
            <h2>Itinerario</h2>
            <ol class="tour-itinerary">
              {tour.itinerary.map((stop, i) => (
                <li class="tour-itinerary__step">
                  <span class="tour-itinerary__num">{i + 1}</span>
                  <span>{stop}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        <!-- Includes / Excludes -->
        <div class="tour-includes-grid">
          {tour.includes && tour.includes.length > 0 && (
            <div class="tour-section">
              <h3><i class="ph-fill ph-check-circle icon" aria-hidden="true" style="color:var(--accent-green)"></i> Incluye</h3>
              <ul class="tour-includes">
                {tour.includes.map(item => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--accent-green)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {tour.excludes && tour.excludes.length > 0 && (
            <div class="tour-section">
              <h3><i class="ph-fill ph-x-circle icon" aria-hidden="true" style="color:var(--text-muted)"></i> No incluye</h3>
              <ul class="tour-includes tour-includes--no">
                {tour.excludes.map(item => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--text-muted)"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Photo gallery -->
        <div class="tour-section">
          <h2>Galería</h2>
          <TourGallery images={galleryImages} alt={tour.name_es} />
        </div>

        <!-- Notes -->
        {tour.notes && (
          <div class="tour-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <p>{tour.notes}</p>
          </div>
        )}
      </div>

      <!-- Right: Booking panel -->
      <aside class="booking-panel" id="bookingPanel">

        <!-- Price -->
        <div class="booking-panel__price">
          {isFree && (
            <>
              <p class="booking-panel__price-label">Pago libre</p>
              <p class="booking-panel__price-main">Tú decides</p>
              {tour.price_note && <p class="booking-panel__price-note">{tour.price_note}</p>}
            </>
          )}
          {isQuote && (
            <>
              <p class="booking-panel__price-label">{hasMinPrice ? 'Precio por persona' : 'Precio bajo consulta'}</p>
              <p class="booking-panel__price-main" id="priceMain">{price}</p>
            </>
          )}
          {isGroup && tour.price_groups && (
            <>
              <p class="booking-panel__price-label">Precio por grupo</p>
              <div class="group-selector">
                <label for="groupPersons">¿Cuántas personas?</label>
                <input type="number" id="groupPersons" min="1" max="100" value={tour.price_groups[0].persons} />
              </div>
              <p class="booking-panel__price-main" id="groupPriceMain">Desde ${tour.price_groups[0].price_usd}</p>
              <div class="group-table" id="groupTable" data-tiers={JSON.stringify(tour.price_groups)}>
                {tour.price_groups.map((g, i) => (
                  <div class:list={['group-table__row', { 'is-selected': i === 0 }]} data-tier-persons={g.persons}>
                    <span>Hasta {g.persons} personas</span>
                    <strong>${g.price_usd}</strong>
                  </div>
                ))}
              </div>
            </>
          )}
          {!isFree && !isQuote && !isGroup && (
            <>
              <p class="booking-panel__price-label">Precio por persona</p>
              <p
                class="booking-panel__price-main"
                id="priceMain"
                data-price-usd={tour.price_usd}
                data-price-child={tour.price_child_6_12}
              >${tour.price_usd} <small>USD</small></p>
              {tour.price_child_6_12 !== undefined && (
                <p class="booking-panel__price-note">Niños 6–12: ${tour.price_child_6_12} · Niños 0–5: {tour.price_child_0_5 === 0 ? 'GRATIS' : `$${tour.price_child_0_5}`}</p>
              )}
            </>
          )}
        </div>

        <div class="divider"></div>

        {/* Embedded Full Booking Form */}
        <form class="booking-form" id="bookingForm" data-tour-slug={tour.slug} data-tour-name={tour.name}>
          <div class="form-group">
            <label for="tour-date">Fecha del tour</label>
            <input type="date" id="tour-date" name="date" required min={new Date().toISOString().split('T')[0]} />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="langPref">Idioma preferido</label>
              <select id="langPref" name="language_pref">
                <option value="ES">Español</option>
                <option value="EN">English</option>
                <option value="FR">Français</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="adults">Adultos</label>
              <input type="number" id="adults" name="adults" min="1" max="20" value="2" />
            </div>
            {tour.price_child_6_12 !== undefined && (
              <div class="form-group">
                <label for="children">Niños (6-12)</label>
                <input type="number" id="children" name="children" min="0" max="10" value="0" />
              </div>
            )}
          </div>

          <div class="divider"></div>

          <p class="form-section-title">Tus datos de contacto</p>
          <div class="form-group">
            <label for="customerName">Nombre completo</label>
            <input type="text" id="customerName" name="customer_name" required placeholder="Como aparece en tu documento" />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="customerEmail">Email</label>
              <input type="email" id="customerEmail" name="customer_email" required placeholder="Para recibir confirmación" />
            </div>
            <div class="form-group">
              <label for="customerPhone">WhatsApp / Teléfono</label>
              <input type="tel" id="customerPhone" name="customer_phone" placeholder="+1 809..." />
            </div>
          </div>

          <div class="form-group">
            <label for="specialRequests">Peticiones especiales (opcional)</label>
            <textarea id="specialRequests" name="special_requests" rows="2" placeholder="Alergias, punto de recogida..."></textarea>
          </div>

          <div class="booking-panel__total" id="priceTotal">
            <span>Total estimado</span>
            <strong id="totalAmount">${tour.price_usd ?? 0} USD</strong>
          </div>

          {/* PayPal Section — Always displaying */}
          {!isQuote && !isFree && !isGroup && (
            <div class="paypal-placeholder" id="paypalBtn">
              <div class="paypal-placeholder__inner">
                <p class="paypal-header-title"><i class="ph ph-credit-card icon" aria-hidden="true"></i> Pago seguro con PayPal</p>
                <div class="paypal-button-wrap" id="paypalButtonWrap">
                  <div id="paypal-button-container"></div>
                  <div class="paypal-gate" id="paypalGate" aria-hidden="false"></div>
                </div>
                <p id="paypalStatus" class="paypal-status" role="status" aria-live="polite"></p>
                <button type="button" id="triggerWhatsappBoujee" class="btn-link-boujee">
                  <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> ¿Prefieres reservar por WhatsApp con Atención VIP?
                </button>
              </div>
            </div>
          )}

          {isQuote && (
            <a href={`/reservar?tour=${tour.slug}`} id="ctaQuote" class="btn btn--primary btn--full btn--lg">
              Solicitar cotización
            </a>
          )}

          {isFree && (
            <a href={`/reservar?tour=${tour.slug}`} id="ctaFree" class="btn btn--primary btn--full btn--lg">
              Reservar mi lugar
            </a>
          )}

          {isGroup && (
            <a href={`/reservar?tour=${tour.slug}`} id="ctaGroup" class="btn btn--primary btn--full btn--lg">
              Cotizar para mi grupo
            </a>
          )}

          {/* "Déjalo para más tarde" Button */}
          <button type="button" id="btnDejaloTarde" class="btn-dejalo-tarde">
            <i class="ph ph-clock-counter-clockwise icon" aria-hidden="true"></i> Déjalo para más tarde
          </button>
          <p id="dejaloTardeToast" class="dejalo-toast" style="display:none" role="status"></p>
        </form>

        <!-- Boujee WhatsApp Booking Modal -->
        <div class="boujee-modal-overlay" id="boujeeModal" aria-hidden="true" role="dialog" aria-modal="true">
          <div class="boujee-modal-card">
            <button type="button" class="boujee-modal-close" id="boujeeModalClose" aria-label="Cerrar ventana">
              <i class="ph ph-x"></i>
            </button>
            <div class="boujee-modal-header">
              <div class="boujee-crown-icon">
                <i class="ph ph-crown"></i>
              </div>
              <span class="boujee-badge"><i class="ph ph-sparkle"></i> Atención VIP Directa</span>
              <h3 class="boujee-title">Reserva Garantizada por WhatsApp</h3>
              <p class="boujee-subtitle">Procesamos tu reserva de forma prioritaria con nuestro equipo en tiempo real para garantizar tu cupo al instante.</p>
            </div>
            
            <div class="boujee-modal-details" id="boujeeModalDetails"></div>
            
            <div class="boujee-modal-footer">
              <a href="#" id="boujeeWhatsappBtn" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp-boujee">
                <i class="ph ph-whatsapp-logo icon"></i>
                <span>Completar Reserva VIP por WhatsApp</span>
              </a>
              <p class="boujee-guarantee"><i class="ph ph-shield-check icon"></i> Respuesta en menos de 5 minutos · Agente exclusivo asignado</p>
            </div>
          </div>
        </div>

        <!-- Trust signals -->
        <ul class="booking-panel__trust">
          {tour.free_cancellation && (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--accent-green)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Cancelación gratis 24h antes
            </li>
          )}
          {tour.instant_confirmation && (
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--accent-green)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Confirmación instantánea
            </li>
          )}
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--accent-green)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Guías locales expertos
          </li>
          <li>
            <i class="ph-fill ph-star" aria-hidden="true" style="color:var(--accent)"></i>
            4.9 TripAdvisor
          </li>
        </ul>
      </aside>
    </div>
  </div>

  <!-- Mobile sticky bar -->
  <div class="mobile-sticky-bar">
    <div class="mobile-sticky-bar__price">
      <small>Desde</small>
      <strong>{price}</strong>
    </div>
    <a
      href={initialBookingHref}
      id="bookingCtaMobile"
      data-base-href={bookingBaseHref}
      class="btn btn--primary"
    >
      {isFree ? 'Reservar' : isQuote || isGroup ? 'Cotizar' : 'Reservar →'}
    </a>
  </div>

</Layout>

<script>
  declare global {
    interface Window { paypal?: any; }
  }

  const priceMain     = document.getElementById('priceMain') as HTMLParagraphElement | null;
  const adultsInput   = document.getElementById('adults') as HTMLInputElement | null;
  const childrenInput = document.getElementById('children') as HTMLInputElement | null;
  const dateInput     = document.getElementById('tour-date') as HTMLInputElement | null;
  const langSelect    = document.getElementById('langPref') as HTMLSelectElement | null;
  const nameInput     = document.getElementById('customerName') as HTMLInputElement | null;
  const emailInput    = document.getElementById('customerEmail') as HTMLInputElement | null;
  const phoneInput    = document.getElementById('customerPhone') as HTMLInputElement | null;
  const requestsInput = document.getElementById('specialRequests') as HTMLTextAreaElement | null;

  const totalAmount   = document.getElementById('totalAmount') as HTMLElement | null;
  const paypalBtn     = document.getElementById('paypalBtn') as HTMLDivElement | null;
  const paypalButtonWrap = document.getElementById('paypalButtonWrap') as HTMLDivElement | null;
  const paypalGate    = document.getElementById('paypalGate') as HTMLDivElement | null;
  const paypalStatus  = document.getElementById('paypalStatus') as HTMLParagraphElement | null;
  const bookingForm   = document.getElementById('bookingForm') as HTMLFormElement | null;
  const tourSlug      = bookingForm?.dataset.tourSlug || '';
  const tourName      = bookingForm?.dataset.tourName || 'Tour';
  const bookingCtaMobile = document.getElementById('bookingCtaMobile') as HTMLAnchorElement | null;

  const boujeeModal        = document.getElementById('boujeeModal') as HTMLDivElement | null;
  const boujeeModalClose   = document.getElementById('boujeeModalClose') as HTMLButtonElement | null;
  const boujeeModalDetails = document.getElementById('boujeeModalDetails') as HTMLDivElement | null;
  const boujeeWhatsappBtn  = document.getElementById('boujeeWhatsappBtn') as HTMLAnchorElement | null;
  const triggerWhatsapp    = document.getElementById('triggerWhatsappBoujee');

  const btnDejaloTarde    = document.getElementById('btnDejaloTarde');
  const dejaloTardeToast  = document.getElementById('dejaloTardeToast');

  let currentAdultPrice = Number(priceMain?.dataset.priceUsd ?? 0);
  let currentChildPrice = priceMain?.dataset.priceChild !== undefined ? Number(priceMain.dataset.priceChild) : undefined;
  let activeVariantId: string | null = null;

  function updateTotal() {
    if (!totalAmount) return;
    const adults   = Math.max(1, parseInt(adultsInput?.value ?? '1') || 1);
    const children = Math.max(0, parseInt(childrenInput?.value ?? '0') || 0);
    const total = adults * currentAdultPrice + children * (currentChildPrice ?? 0);
    totalAmount.textContent = `$${total} USD`;
  }

  adultsInput?.addEventListener('input', updateTotal);
  childrenInput?.addEventListener('input', updateTotal);

  // Pre-fill fields from URL params
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('date') && dateInput) dateInput.value = urlParams.get('date')!;
  if (urlParams.get('adults') && adultsInput) adultsInput.value = urlParams.get('adults')!;
  if (urlParams.get('children') && childrenInput) childrenInput.value = urlParams.get('children')!;
  if (urlParams.get('name') && nameInput) nameInput.value = urlParams.get('name')!;
  if (urlParams.get('email') && emailInput) emailInput.value = urlParams.get('email')!;
  if (urlParams.get('phone') && phoneInput) phoneInput.value = urlParams.get('phone')!;
  if (urlParams.get('requests') && requestsInput) requestsInput.value = urlParams.get('requests')!;
  if (urlParams.get('variant')) activeVariantId = urlParams.get('variant');

  updateTotal();

  function withFormFields(baseUrl: string): string {
    const url = new URL(baseUrl, window.location.href);
    if (dateInput?.value) url.searchParams.set('date', dateInput.value);
    if (adultsInput?.value) url.searchParams.set('adults', adultsInput.value);
    if (childrenInput?.value) url.searchParams.set('children', childrenInput.value);
    if (nameInput?.value) url.searchParams.set('name', nameInput.value.trim());
    if (emailInput?.value) url.searchParams.set('email', emailInput.value.trim());
    if (phoneInput?.value) url.searchParams.set('phone', phoneInput.value.trim());
    if (requestsInput?.value) url.searchParams.set('requests', requestsInput.value.trim());
    if (activeVariantId) url.searchParams.set('variant', activeVariantId);
    return url.toString();
  }

  // "Déjalo para más tarde" handler
  btnDejaloTarde?.addEventListener('click', () => {
    const shareableUrl = withFormFields(window.location.href);

    navigator.clipboard.writeText(shareableUrl).then(() => {
      if (dejaloTardeToast) {
        dejaloTardeToast.textContent = '¡Enlace guardado! Copiado al portapapeles con tus datos listos para después.';
        dejaloTardeToast.style.display = 'block';
        setTimeout(() => { dejaloTardeToast.style.display = 'none'; }, 5000);
      }
    }).catch(() => {
      window.open(shareableUrl, '_blank');
    });
  });

  // Quote/free/group CTAs hand off whatever the visitor already typed here
  // so they don't have to re-enter it on /reservar.
  ['ctaQuote', 'ctaFree', 'ctaGroup'].forEach((id) => {
    const link = document.getElementById(id) as HTMLAnchorElement | null;
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = withFormFields(link.href);
    });
  });

  // Mobile sticky "Reservar" bar links to /reservar same as the CTAs above --
  // it needs the same hand-off or a visitor who filled in the embedded form
  // loses everything they typed the moment they tap it.
  bookingCtaMobile?.addEventListener('click', (e) => {
    e.preventDefault();
    window.location.href = withFormFields(bookingCtaMobile.href);
  });

  // Same hand-off for a quote-priced variant's "Cotizar esta opción" link.
  document.querySelectorAll<HTMLAnchorElement>('.variant-quote-cta').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = withFormFields(link.href);
    });
  });

  // Variant selector handler
  document.querySelectorAll<HTMLButtonElement>('.variant-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.variant || null;
      activeVariantId = id;
      btn.closest('.tour-variants')?.querySelectorAll('.variant-tab').forEach(b => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.closest('.tour-variants')?.querySelectorAll('.variant-panel').forEach(p => {
        p.classList.remove('is-active');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      btn.closest('.tour-variants')?.querySelector(`[data-panel="${id}"]`)?.classList.add('is-active');

      if (btn.dataset.priceUsd && priceMain) {
        currentAdultPrice = Number(btn.dataset.priceUsd);
        currentChildPrice = btn.dataset.priceChild !== undefined ? Number(btn.dataset.priceChild) : undefined;
        priceMain.innerHTML = `$${btn.dataset.priceUsd} <small>USD</small>`;
        updateTotal();
      }

      // Carry the selected variant through to the mobile sticky CTA so it
      // matches what's on screen instead of silently reverting to the
      // tour's base price/variant.
      if (bookingCtaMobile) {
        const base = bookingCtaMobile.dataset.baseHref ?? '';
        bookingCtaMobile.href = id ? `${base}&variant=${encodeURIComponent(id)}` : base;
      }
    });
  });

  // Dynamic per-group price: given how many people, snap to the matching
  // price_groups tier and reflect it live in the price display + table.
  const groupPersonsInput = document.getElementById('groupPersons') as HTMLInputElement | null;
  const groupTable        = document.getElementById('groupTable') as HTMLDivElement | null;
  const groupPriceMain    = document.getElementById('groupPriceMain') as HTMLParagraphElement | null;

  if (groupPersonsInput && groupTable && groupPriceMain) {
    const tiers: { persons: number; price_usd: number }[] = JSON.parse(groupTable.dataset.tiers ?? '[]');

    function matchTier(personCount: number) {
      const sorted = [...tiers].sort((a, b) => a.persons - b.persons);
      return sorted.find(t => personCount <= t.persons) ?? sorted[sorted.length - 1];
    }

    function updateGroupPrice() {
      const count = Math.max(1, parseInt(groupPersonsInput!.value) || 1);
      const tier = matchTier(count);
      if (!tier) return;

      groupPriceMain!.textContent = `$${tier.price_usd}`;

      groupTable!.querySelectorAll<HTMLDivElement>('.group-table__row').forEach(row => {
        row.classList.toggle('is-selected', Number(row.dataset.tierPersons) === tier.persons);
      });
    }

    groupPersonsInput.addEventListener('input', updateGroupPrice);
    updateGroupPrice();
  }

  // Boujee Modal controller
  function openBoujeeModal() {
    if (!boujeeModal || !boujeeModalDetails || !boujeeWhatsappBtn) return;
    const date = dateInput?.value || 'Por definir';
    const adults = parseInt(adultsInput?.value ?? '1') || 1;
    const children = parseInt(childrenInput?.value ?? '0') || 0;
    const totalText = totalAmount?.textContent || '$0 USD';
    const customerName = nameInput?.value.trim() || 'Cliente VIP';

    boujeeModalDetails.innerHTML = `
      <div class="boujee-detail-row"><span>Tour:</span><strong>${tourName}</strong></div>
      <div class="boujee-detail-row"><span>Fecha:</span><span>${date}</span></div>
      <div class="boujee-detail-row"><span>Pasajeros:</span><span>${adults} Adulto(s)${children > 0 ? `, ${children} Niños` : ''}</span></div>
      <div class="boujee-detail-row"><span>Total estimado:</span><strong>${totalText}</strong></div>
    `;

    const waMsg = `Hola Kayoe Excursiones! Mi nombre es ${customerName}. Me gustaría confirmar mi reserva por WhatsApp:\n\n` +
      `📍 Tour: ${tourName}\n📅 Fecha: ${date}\n👥 Personas: ${adults} Adultos${children > 0 ? `, ${children} Niños` : ''}\n💳 Total estimado: ${totalText}\n\nQuedo a la espera de la confirmación. ¡Gracias!`;

    boujeeWhatsappBtn.href = `https://wa.me/18099950095?text=${encodeURIComponent(waMsg)}`;
    boujeeModal.classList.add('is-active');
    boujeeModal.setAttribute('aria-hidden', 'false');
  }

  function closeBoujeeModal() {
    boujeeModal?.classList.remove('is-active');
    boujeeModal?.setAttribute('aria-hidden', 'true');
  }

  boujeeModalClose?.addEventListener('click', closeBoujeeModal);
  boujeeModal?.addEventListener('click', (e) => { if (e.target === boujeeModal) closeBoujeeModal(); });
  triggerWhatsapp?.addEventListener('click', openBoujeeModal);

  // PayPal SDK logic
  function setStatus(text: string, state: 'loading' | 'ok' | 'error' | '' = '') {
    if (!paypalStatus) return;
    paypalStatus.textContent = text;
    if (state) paypalStatus.setAttribute('data-state', state);
    else paypalStatus.removeAttribute('data-state');
  }

  class HandledError extends Error {}

  function firstMissingField(): { el: HTMLElement | null; message: string } | null {
    if (!dateInput?.value) return { el: dateInput, message: 'Selecciona la fecha del tour.' };
    if (!nameInput?.value.trim()) return { el: nameInput, message: 'Ingresa tu nombre completo.' };
    if (!emailInput?.value.trim() || !emailInput.checkValidity()) return { el: emailInput, message: 'Ingresa un email válido.' };
    return null;
  }

  function validateBookingFields(): string | null {
    const missing = firstMissingField();
    if (!missing) return null;
    missing.el?.focus();
    return missing.message;
  }

  function requiredFieldsComplete(): boolean {
    return firstMissingField() === null;
  }

  function updatePaypalGate() {
    if (!paypalButtonWrap || !paypalGate) return;
    const ready = requiredFieldsComplete();
    paypalButtonWrap.classList.toggle('is-ready', ready);
    paypalGate.setAttribute('aria-hidden', ready ? 'true' : 'false');
  }

  [dateInput, nameInput, emailInput].forEach((el) => {
    el?.addEventListener('input', updatePaypalGate);
    el?.addEventListener('change', updatePaypalGate);
  });
  updatePaypalGate();

  paypalGate?.addEventListener('click', () => {
    setStatus('Completa todos los campos disponibles para continuar con el pago.', 'error');
    firstMissingField()?.el?.focus();
  });

  let sdkLoadPromise: Promise<void> | null = null;
  function loadPayPalSdk(): Promise<void> {
    if (sdkLoadPromise) return sdkLoadPromise;

    const fallbackClientId = 'BAA60c5lelU_3u5DprqJqARAn19zZnmFBZRX2WIiac7ozM_SKgj5XIRU9gz2mSkwm6Yk_NahLiN5HwWjVc';

    sdkLoadPromise = fetch('/api/paypal/client-id')
      .then(async (r) => {
        if (!r.ok) throw new Error(`http_${r.status}`);
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('application/json')) throw new Error('non_json_response');
        return r.json();
      })
      .then(({ clientId }) => clientId || fallbackClientId)
      .catch((err) => {
        console.warn('API /api/paypal/client-id unavailable, using default Client ID:', err);
        return fallbackClientId;
      })
      .then((clientIdToUse) => {
        return new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(clientIdToUse)}&currency=USD&intent=capture`;
          script.onload = () => resolve();
          script.onerror = () => {
            console.error('PayPal SDK script failed to load');
            setStatus('No se pudo cargar la pasarela automática de PayPal.', 'error');
            openBoujeeModal();
            reject(new Error('sdk_load_failed'));
          };
          document.head.appendChild(script);
        });
      });

    return sdkLoadPromise;
  }

  let buttonsRendered = false;
  function ensurePayPalButtons() {
    if (buttonsRendered || !paypalBtn) return;
    buttonsRendered = true;

    loadPayPalSdk()
      .then(() => {
        if (!window.paypal) return;
        window.paypal.Buttons({
          style: { layout: 'vertical', color: 'gold', label: 'paypal' },
          createOrder: async () => {
            const err = validateBookingFields();
            if (err) { setStatus(err, 'error'); throw new HandledError(err); }
            setStatus('Preparando el pago…', 'loading');
            try {
              const res = await fetch('/api/paypal/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  tour_slug: tourSlug,
                  variant_id: activeVariantId,
                  adults: parseInt(adultsInput?.value ?? '1') || 1,
                  children: parseInt(childrenInput?.value ?? '0') || 0,
                }),
              });
              const data = await res.json();
              if (!res.ok || !data.id) { openBoujeeModal(); throw new HandledError(data.error); }
              setStatus('', '');
              return data.id;
            } catch (e) {
              if (!(e instanceof HandledError)) openBoujeeModal();
              throw e;
            }
          },
          onApprove: async (data: any) => {
            setStatus('Confirmando tu pago…', 'loading');
            try {
              const res = await fetch('/api/paypal/capture-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  orderID: data.orderID,
                  tour_slug: tourSlug,
                  variant_id: activeVariantId,
                  tour_name: tourName,
                  customer_name: nameInput?.value.trim(),
                  customer_email: emailInput?.value.trim(),
                  customer_phone: phoneInput?.value.trim(),
                  tour_date: dateInput?.value,
                  adults: parseInt(adultsInput?.value ?? '1') || 1,
                  children: parseInt(childrenInput?.value ?? '0') || 0,
                  language_pref: langSelect?.value,
                  special_requests: requestsInput?.value.trim(),
                }),
              });
              const result = await res.json();
              if (!res.ok || !result.success) { openBoujeeModal(); return; }
              window.location.href = `/confirmacion?ref=${encodeURIComponent(result.reference)}`;
            } catch (err) {
              openBoujeeModal();
            }
          },
          onCancel: () => setStatus('Pago cancelado.', ''),
          onError: (err: unknown) => {
            if (err instanceof HandledError) return;
            openBoujeeModal();
          }
        }).render('#paypal-button-container');
      })
      .catch(() => { buttonsRendered = false; });
  }

  if (paypalBtn) ensurePayPalButtons();
  bookingForm?.addEventListener('submit', (e) => e.preventDefault());
</script>

