.booking-panel__trust {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: .4rem;
}
.booking-panel__trust li {
  display: flex;
  align-items: center;
  gap: .5rem;
  font-size: .8rem;
  color: var(--text-muted);
}

/* Variants */
.tour-variants { }
.variant-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
