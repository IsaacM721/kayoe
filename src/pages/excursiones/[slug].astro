}
@media (min-width: 1024px) { .mobile-sticky-bar { display: none; } }

.mobile-sticky-bar__price small {
  display: block;
  font-size: .7rem;
  color: var(--text-muted);
}
.mobile-sticky-bar__price strong {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--accent-green);
}

/* PayPal placeholder + gating */
.paypal-placeholder { margin-bottom: 1rem; }
.paypal-placeholder__inner { background: #f0f9ff; border: 1.5px dashed #93C5FD; border-radius: var(--radius-md); padding: 1.25rem; text-align: center; }
.paypal-header-title { font-weight: 600; color: var(--primary); margin-bottom: .4rem; }
.paypal-button-wrap { position: relative; min-height: 45px; }
.paypal-button-wrap:not(.is-ready) #paypal-button-container { opacity: .4; filter: grayscale(.4); pointer-events: none; }
.paypal-gate { position: absolute; inset: 0; z-index: 2; cursor: not-allowed; }
.paypal-button-wrap.is-ready .paypal-gate { display: none; }
.paypal-status { font-weight: 500; font-size: .85rem; margin-top: .6rem; min-height: 1.2em; }
.paypal-status[data-state="error"] { color: #dc2626; }
.paypal-status[data-state="loading"] { color: var(--text-muted); }
.paypal-status[data-state="ok"] { color: var(--accent-green); }
.btn-link-boujee { background: transparent; border: none; color: var(--primary); font-size: 0.82rem; font-weight: 600; margin-top: 0.75rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: underline; text-underline-offset: 3px; }
