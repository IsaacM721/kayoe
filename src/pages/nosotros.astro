---
import Layout from '@/layouts/Layout.astro';
import { getWhatsAppURL } from '@/utils/whatsapp';
import { resolveImage, teamImageUrl } from '@/data/images';

const waURL = getWhatsAppURL();
const aboutHeroImg = resolveImage('about-hero', 1200);
const aboutTeamImg = resolveImage('about-team', 600);
const guides = [
  { slug: 'edward',   name: 'Edward Martínez',  role: 'Guía Local',    bio: 'Experto en historia colonial y cultura urbana dominicana. Edward lleva más de 5 años guiando turistas por los rincones más emblemáticos de la Ciudad Colonial.' },
  { slug: 'orlando',  name: 'Orlando Reynoso',  role: 'Guía Local',    bio: 'Apasionado por compartir la riqueza cultural y natural de la República Dominicana. Orlando especializado en ecoturismo y tours culturales.' },
  { slug: 'leopoldo', name: 'Leopoldo Pérez',   role: 'Guía Nacional', bio: 'Guía certificado MITUR con licencia nacional. Leopoldo opera tours en todo el país, desde Samaná hasta Puerto Plata.' },
];
---

<Layout
  title="Nosotros — Quiénes somos"
  description="Somos Kayoe Excursiones, pioneros del FREE Walking Tour en República Dominicana desde 2018. Conoce nuestro equipo de guías locales expertos."
  canonical="/nosotros"
>

  <!-- Hero -->
  <section class="about-hero" style={`--about-hero-bg: url('${aboutHeroImg}')`}>
    <div class="about-hero__overlay"></div>
    <div class="container about-hero__content">
      <h1>Somos un equipo local<br />apasionado por crear<br />experiencias auténticas</h1>
      <p>Kayoe Excursiones — Santo Domingo, República Dominicana</p>
    </div>
  </section>

  <!-- Historia -->
  <section class="section">
    <div class="container about-story">
      <div class="about-story__text">
        <span class="about-eyebrow">Nuestra historia</span>
        <h2>Nacidos en la Ciudad Colonial</h2>
        <p>Kayoe Excursiones nació en 2018 como una idea simple pero poderosa: mostrar la verdadera República Dominicana a través de los ojos de quienes la viven.</p>
        <p>Fuimos los <strong>primeros en ofrecer free walking tours en la República Dominicana</strong>, democratizando el acceso a guías locales expertos para todos los bolsillos. Hoy, más de 500 tours después, seguimos siendo el mismo equipo pequeño, cercano y apasionado.</p>
        <p>Durante la pandemia de COVID-19, cuando el turismo se detuvo, reinventamos nuestra propuesta: tours más especializados, grupos más reducidos, experiencias más auténticas. De esa transformación salió la Kayoe que conoces hoy.</p>
      </div>
      <div class="about-story__img">
        <img
          src={aboutTeamImg}
          alt="Ciudad Colonial de Santo Domingo — donde nació Kayoe Excursiones"
          width="600"
          height="400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Misión -->
  <section class="section section--sm mision-section">
    <div class="container mision-grid">
      <div class="mision-card">
        <span class="mision-card__icon"><i class="ph ph-target" aria-hidden="true"></i></span>
        <h3>Misión</h3>
        <p>Ofrecer turismo urbano, cultural y ecológico, con un contenido histórico, accesible y a la vanguardia — conectando visitantes con la auténtica esencia dominicana.</p>
      </div>
      <div class="mision-card">
        <span class="mision-card__icon"><i class="ph ph-eye" aria-hidden="true"></i></span>
        <h3>Visión</h3>
        <p>Ser la empresa de tours de referencia en la República Dominicana, reconocida por la calidad de sus guías, la autenticidad de sus experiencias y su compromiso con el turismo sostenible.</p>
      </div>
      <div class="mision-card">
        <span class="mision-card__icon"><i class="ph ph-diamond" aria-hidden="true"></i></span>
        <h3>Valores</h3>
        <p>Autenticidad, profesionalismo, respeto por la cultura local, sostenibilidad y excelencia en cada experiencia que creamos para nuestros viajeros.</p>
      </div>
    </div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="section why-section">
    <div class="container">
      <div class="section-header">
        <h2>¿Por qué elegirnos?</h2>
      </div>
      <div class="grid-4">
        {[
          { icon: 'ph-user', title: 'Guías locales', desc: 'Expertos que conocen cada rincón, historia y secreto de la ciudad' },
          { icon: 'ph-trophy', title: 'Pioneros free tour', desc: 'Los primeros en RD en ofrecer free walking tours desde 2018' },
          { icon: 'ph-users-three', title: 'Grupos reducidos', desc: 'Máximo 6 personas. Atención personalizada, no masas de turistas' },
          { icon: 'ph-calendar-check', title: 'Reserva flexible', desc: 'Cancela gratis hasta 24 horas antes. Sin riesgo, sin complicaciones' },
        ].map(item => (
          <div class="why-card">
            <div class="why-card__icon"><i class={`ph ${item.icon}`} aria-hidden="true"></i></div>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Guías -->
  <section class="section guides-section">
    <div class="container">
      <div class="section-header">
        <h2>Conoce a nuestros guías</h2>
        <p>El corazón de Kayoe Excursiones</p>
      </div>
      <div class="guides-grid">
        {guides.map(guide => (
          <div class="guide-card">
            <div class="guide-card__photo">
              <img
                src={teamImageUrl(guide.slug, guide.name, 256)}
                alt={`${guide.name} — ${guide.role} Kayoe Excursiones`}
                width="200"
                height="200"
                loading="lazy"
              />
            </div>
            <div class="guide-card__info">
              <h3>{guide.name}</h3>
              <span class="guide-card__role">{guide.role}</span>
              <p>{guide.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="trust-bar">
    <div class="container trust-bar__inner">
      <div class="trust-bar__item"><span class="trust-bar__icon"><i class="ph ph-map-trifold" aria-hidden="true"></i></span><div><strong>500+</strong><span>Tours realizados</span></div></div>
      <div class="trust-bar__item"><span class="trust-bar__icon"><i class="ph-fill ph-star" aria-hidden="true"></i></span><div><strong>4.9</strong><span>300+ reseñas</span></div></div>
      <div class="trust-bar__item"><span class="trust-bar__icon"><i class="ph ph-translate" aria-hidden="true"></i></span><div><strong>6 Idiomas</strong><span>ES · EN · FR · IT · PT · DE</span></div></div>
      <div class="trust-bar__item"><span class="trust-bar__icon"><i class="ph ph-trophy" aria-hidden="true"></i></span><div><strong>Desde 2018</strong><span>Pioneros free tour RD</span></div></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="container cta-final__inner">
      <h2>¿Lista para vivir Santo Domingo de verdad?</h2>
      <p>Únete a los miles de viajeros que ya confiaron en Kayoe.</p>
      <div class="cta-final__buttons">
        <a href="/excursiones" class="btn btn--primary btn--lg">Ver todos los tours →</a>
        <a href={waURL} target="_blank" rel="noopener" class="btn btn--whatsapp btn--lg"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i> WhatsApp</a>
      </div>
    </div>
  </section>

</Layout>

<style>
.about-hero {
  position: relative;
  background: var(--about-hero-bg, var(--primary)) center / cover no-repeat;
  padding-block: 6rem;
  color: #fff;
}
.about-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(27,58,92,.85) 40%, rgba(27,58,92,.6));
}
.about-hero__content {
  position: relative;
  z-index: 1;
}
.about-hero__content h1 {
  color: #fff;
  font-size: clamp(1.75rem, 4vw, 3rem);
  margin-bottom: .75rem;
  text-shadow: 0 2px 12px rgba(0,0,0,.3);
}
.about-hero__content p { color: rgba(255,255,255,.75); font-size: 1rem; }

.about-eyebrow {
  display: inline-block;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--primary);
  margin-bottom: .75rem;
}

.about-story {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}
@media (min-width: 768px) { .about-story { grid-template-columns: 1fr 1fr; } }

.about-story__text h2 { margin-bottom: 1rem; }
.about-story__text p  { color: var(--text-muted); line-height: 1.75; margin-bottom: 1rem; }
.about-story__text strong { color: var(--primary); }
.about-story__img img { border-radius: var(--radius-lg); width: 100%; }

.mision-section { background: var(--bg-light); }
.mision-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 768px) { .mision-grid { grid-template-columns: repeat(3, 1fr); } }

.mision-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 2rem 1.5rem;
  border: 1px solid var(--border);
  text-align: center;
}
.mision-card__icon { font-size: 2.5rem; display: flex; justify-content: center; margin-bottom: 1rem; color: var(--accent); }
.mision-card h3 { color: var(--primary); margin-bottom: .75rem; }
.mision-card p  { font-size: .9rem; color: var(--text-muted); line-height: 1.6; }

.why-section { background: #fff; }
.why-card {
  text-align: center;
  padding: 1.75rem 1.25rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--border);
}
.why-card__icon { font-size: 2.25rem; margin-bottom: .75rem; display: flex; justify-content: center; color: var(--accent); }
.why-card h4 { margin-bottom: .4rem; color: var(--primary); }
.why-card p  { font-size: .875rem; color: var(--text-muted); line-height: 1.6; }

.guides-section { background: var(--bg-light); }
.guides-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}
@media (min-width: 640px) { .guides-grid { grid-template-columns: repeat(3, 1fr); } }

.guide-card {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border);
  text-align: center;
  padding-bottom: 1.5rem;
}
.guide-card__photo {
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
}
.guide-card__photo img { width: 100%; height: 100%; object-fit: cover; }
.guide-card__info { padding: 1.25rem 1rem 0; }
.guide-card__info h3 { margin-bottom: .25rem; font-size: 1.05rem; }
.guide-card__role {
  display: inline-block;
  font-size: .78rem;
  font-weight: 600;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: .75rem;
}
.guide-card__info p { font-size: .85rem; color: var(--text-muted); line-height: 1.6; }

.trust-bar { background: var(--primary); padding-block: 1.5rem; }
.trust-bar__inner { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
@media (min-width: 768px) { .trust-bar__inner { grid-template-columns: repeat(4, 1fr); } }
.trust-bar__item { display: flex; align-items: center; gap: .75rem; color: #fff; }
.trust-bar__icon { font-size: 1.6rem; color: var(--accent); display: inline-flex; }
.trust-bar__item strong { display: block; font-size: 1.1rem; font-weight: 800; }
.trust-bar__item span  { font-size: .78rem; opacity: .75; }

.cta-final { background: var(--primary-dark); padding-block: 4.5rem; color: #fff; }
.cta-final__inner { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
.cta-final__inner h2 { color: #fff; }
.cta-final__inner p  { color: rgba(255,255,255,.8); }
.cta-final__buttons  { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; }
</style>
