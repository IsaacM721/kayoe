---
import Layout from '@/layouts/Layout.astro';
import { getWhatsAppURL } from '@/utils/whatsapp';

const waURL = getWhatsAppURL();
---

<Layout
  title="Reserva confirmada — Kayoe Excursiones"
  description="Tu reserva ha sido confirmada."
  canonical="/confirmacion"
>
  <section class="section">
    <div class="container confirmacion">
      <div class="confirmacion__icon"><i class="ph ph-check-circle" aria-hidden="true"></i></div>
      <h1>¡Reserva confirmada!</h1>
      <p class="confirmacion__ref">
        Referencia: <strong id="refNumber">—</strong>
      </p>
      <p>
        Te hemos enviado los detalles a tu correo. Si tienes preguntas o necesitas
        ajustar algo, contáctanos por WhatsApp con tu número de referencia a la mano.
      </p>
      <div class="confirmacion__actions">
        <a href={waURL} target="_blank" rel="noopener" class="btn btn--whatsapp">
          <i class="ph ph-whatsapp-logo" aria-hidden="true"></i> Escribir por WhatsApp
        </a>
        <a href="/" class="btn btn--outline-primary">Volver al inicio</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .confirmacion {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    padding-block: 2rem;
  }
  .confirmacion__icon { font-size: 3.5rem; color: var(--accent-green); margin-bottom: .5rem; }
  .confirmacion__ref { font-size: 1.1rem; margin-bottom: 1rem; }
  .confirmacion__actions {
    display: flex;
    gap: .75rem;
    justify-content: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const ref = params.get('ref');
  const el = document.getElementById('refNumber');
  if (el) el.textContent = ref || '—';
</script>
