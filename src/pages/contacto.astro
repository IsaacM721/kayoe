---
import Layout from '@/layouts/Layout.astro';
import { getWhatsAppURL, PHONE_PRIMARY, PHONE_SECONDARY, EMAIL } from '@/utils/whatsapp';

const waURL = getWhatsAppURL();
---

<Layout
  title="Contacto"
  description="Contáctanos para reservar o cotizar tu tour en Santo Domingo. WhatsApp, email o formulario — respondemos en minutos."
  canonical="/contacto"
>

  <section class="contact-banner">
    <div class="contact-banner__overlay"></div>
    <div class="container contact-banner__content">
      <h1>Contáctanos</h1>
      <p>Estamos aquí para ayudarte — respondemos en minutos</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">

      <!-- Info -->
      <div class="contact-info">
        <h2>Habla con nosotros</h2>
        <p>¿Tienes preguntas sobre un tour, quieres personalizar tu itinerario o necesitas info? Escríbenos por WhatsApp — es la forma más rápida.</p>

        <div class="contact-cards">
          <a href={waURL} target="_blank" rel="noopener" class="contact-card contact-card--wa">
            <span class="contact-card__icon contact-card__icon--wa"><i class="ph ph-whatsapp-logo" aria-hidden="true"></i></span>
            <div>
              <strong>WhatsApp</strong>
              <span>{PHONE_PRIMARY}</span>
            </div>
          </a>
          <a href={`tel:${PHONE_SECONDARY.replace(/\s/g,'')}`} class="contact-card">
            <span class="contact-card__icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span>
            <div>
              <strong>Teléfono</strong>
              <span>{PHONE_SECONDARY}</span>
            </div>
          </a>
          <a href={`mailto:${EMAIL}`} class="contact-card">
            <span class="contact-card__icon"><i class="ph ph-envelope-simple" aria-hidden="true"></i></span>
            <div>
              <strong>Email</strong>
              <span>{EMAIL}</span>
            </div>
          </a>
          <div class="contact-card">
            <span class="contact-card__icon"><i class="ph ph-clock" aria-hidden="true"></i></span>
            <div>
              <strong>Horario</strong>
              <span>Todos los días · 7:00 AM – 7:00 PM</span>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="contact-social">
          <h4>Síguenos en redes</h4>
          <div class="contact-social__links">
            <a href="https://www.instagram.com/kayoe.excursiones" target="_blank" rel="noopener"><i class="ph ph-instagram-logo icon" aria-hidden="true"></i> Instagram</a>
            <a href="https://www.facebook.com/kayoe.excursiones" target="_blank" rel="noopener"><i class="ph ph-facebook-logo icon" aria-hidden="true"></i> Facebook</a>
            <a href="https://www.youtube.com/@kayoeexcursiones" target="_blank" rel="noopener"><i class="ph ph-youtube-logo icon" aria-hidden="true"></i> YouTube</a>
            <a href="https://www.tiktok.com/@kayoe.excursiones" target="_blank" rel="noopener"><i class="ph ph-tiktok-logo icon" aria-hidden="true"></i> TikTok</a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="contact-form-wrap">
        <h2>Envíanos un mensaje</h2>
        <form class="contact-form" action="/api/quote" method="post" id="contactForm">
          <input type="hidden" name="service" value="contacto" />
          <div class="form-group">
            <label for="c-name">Nombre completo</label>
            <input type="text" id="c-name" name="name" required placeholder="Tu nombre" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="c-email">Email</label>
              <input type="email" id="c-email" name="email" placeholder="tu@email.com" />
            </div>
            <div class="form-group">
              <label for="c-phone">WhatsApp / Teléfono</label>
              <input type="tel" id="c-phone" name="phone" required placeholder="+1 809..." />
            </div>
          </div>
          <div class="form-group">
            <label for="c-subject">Asunto</label>
            <select id="c-subject" name="subject">
              <option value="">Selecciona un asunto...</option>
              <option value="reserva">Reservar un tour</option>
              <option value="cotizar">Cotizar un tour</option>
              <option value="traslado">Traslado</option>
              <option value="seguro">Seguro de viaje</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          <div class="form-group">
            <label for="c-message">Mensaje</label>
            <textarea id="c-message" name="message" rows="5" placeholder="Cuéntanos qué necesitas..."></textarea>
          </div>
          <button type="submit" class="btn btn--primary btn--full btn--lg">
            Enviar mensaje →
          </button>
          <p class="form-note">
            ¿Prefieres más rapidez? <a href={waURL} target="_blank">Escríbenos por WhatsApp</a>
          </p>
        </form>
      </div>

    </div>
  </section>

</Layout>

<style>
.contact-banner {
  position: relative;
  background: var(--primary);
  padding-block: 3rem;
  color: #fff;
}
.contact-banner__overlay {
  position: absolute;
  inset: 0;
  background: rgba(18,40,64,.5);
}
.contact-banner__content { position: relative; z-index: 1; }
.contact-banner__content h1 { color: #fff; margin-bottom: .4rem; }
.contact-banner__content p  { color: rgba(255,255,255,.75); }

.contact-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: flex-start;
}
@media (min-width: 900px) { .contact-layout { grid-template-columns: 1fr 1fr; } }

.contact-info h2, .contact-form-wrap h2 { margin-bottom: .75rem; }
.contact-info > p { color: var(--text-muted); line-height: 1.7; margin-bottom: 1.5rem; }

.contact-cards {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  margin-bottom: 2rem;
}
.contact-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-md);
  background: #fff;
  transition: border-color var(--transition), box-shadow var(--transition);
  text-decoration: none;
}
.contact-card:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); }
.contact-card--wa { border-color: #25D366; }
.contact-card--wa:hover { background: #f0fdf4; }

.contact-card__icon { font-size: 1.6rem; flex-shrink: 0; display: inline-flex; color: var(--primary); }
.contact-card__icon--wa { color: #25D366; }
.contact-card strong { display: block; font-size: .875rem; font-weight: 700; color: var(--text-dark); }
.contact-card span   { font-size: .82rem; color: var(--text-muted); }

.contact-social h4 { font-size: .85rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); margin-bottom: .75rem; }
.contact-social__links { display: flex; flex-wrap: wrap; gap: .5rem; }
.contact-social__links a {
  padding: .4rem .9rem;
  border: 1.5px solid var(--border);
  border-radius: var(--radius-full);
  font-size: .82rem;
  font-weight: 600;
  color: var(--text-dark);
  transition: all var(--transition);
}
.contact-social__links a:hover { border-color: var(--primary); color: var(--primary); }

.contact-form { display: flex; flex-direction: column; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
textarea { resize: vertical; min-height: 120px; }

.form-note {
  text-align: center;
  font-size: .78rem;
  color: var(--text-muted);
  margin-top: .75rem;
}
.form-note a { color: var(--accent-green); font-weight: 600; }
</style>
