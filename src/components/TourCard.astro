---
import type { Tour } from '@/data/tours';
import { formatPrice, tourImageUrl, CATEGORIES } from '@/data/tours';
import { getWhatsAppURL } from '@/utils/whatsapp';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;

const price   = formatPrice(tour);
const isQuote = tour.price_type === 'quote';
const isFree  = tour.price_type === 'free-tip';
const waURL   = getWhatsAppURL(tour.name_es);
const imgSrc  = tourImageUrl(tour.image, 400, 250);
const catLabel = CATEGORIES[tour.category]?.label_es ?? tour.category;

const badgeLabels: Record<string, string> = {
  popular:   'MÁS POPULAR',
  nuevo:     'NUEVO',
  ecologico: 'ECOLÓGICO',
  aventura:  'AVENTURA',
  familiar:  'FAMILIAR',
};
---

<article class="tour-card">
  <!-- Image -->
  <a href={`/excursiones/${tour.slug}`} class="tour-card__img-wrap" tabindex="-1" aria-hidden="true">
    <img
      src={imgSrc}
      alt={`Tour ${tour.name_es} — Kayoe Excursiones`}
      width="400"
      height="250"
      loading="lazy"
      decoding="async"
      class="tour-card__img"
    />
    {tour.badge && (
      <span class={`badge badge--${tour.badge} tour-card__badge`}>
        {badgeLabels[tour.badge] ?? tour.badge.toUpperCase()}
      </span>
    )}
  </a>

  <!-- Body -->
  <div class="tour-card__body">
    <p class="tour-card__location">{tour.location}</p>
    <h3 class="tour-card__title">
      <a href={`/excursiones/${tour.slug}`}>{tour.name_es}</a>
    </h3>

    <!-- Rating -->
    {tour.rating && (
      <div class="stars">
        {'★'.repeat(Math.round(tour.rating))}
        <span class="stars__count">{tour.rating} ({tour.review_count})</span>
      </div>
    )}

    <!-- Meta pills (blue) -->
    <div class="tour-card__pills">
      {tour.duration && <span class="pill pill--blue">⏱ {tour.duration}</span>}
      {tour.languages && <span class="pill pill--blue">🌐 {tour.languages.split('|')[0].trim()}</span>}
      {(tour.includes?.some(i => i.toLowerCase().includes('transporte'))) && (
        <span class="pill pill--blue">🚐 Transporte</span>
      )}
    </div>

    <!-- Includes pills (green) -->
    {tour.includes && tour.includes.length > 0 && (
      <div class="tour-card__pills">
        {tour.includes.slice(0, 2).map(item => (
          <span class="pill pill--green">✓ {item}</span>
        ))}
      </div>
    )}

    <!-- Trust badge -->
    {tour.instant_confirmation && (
      <div class="trust-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="var(--accent-green)"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Confirmación instantánea
      </div>
    )}
  </div>

  <!-- Footer -->
  <div class="tour-card__footer">
    <div class="tour-card__price">
      {isFree  && <span class="tour-card__price-label">Pago libre</span>}
      {isQuote && <span class="tour-card__price-label">Cotizar vía WhatsApp</span>}
      {!isFree && !isQuote && <span class="tour-card__price-label">Desde</span>}
      <strong class="tour-card__price-value">{price}</strong>
      {tour.price_child_0_5 === 0 && <small>Niños gratis</small>}
    </div>

    {isQuote ? (
      <a href={waURL} target="_blank" rel="noopener" class="btn btn--whatsapp btn--sm">
        💬 Cotizar
      </a>
    ) : (
      <a href={`/excursiones/${tour.slug}`} class="btn btn--primary btn--sm">
        Reservar
      </a>
    )}
  </div>
</article>

<style>
.tour-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: box-shadow var(--transition), transform var(--transition);
  border: 1px solid var(--border);
}
.tour-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

/* Image */
.tour-card__img-wrap {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 16 / 10;
}
.tour-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .4s ease;
}
.tour-card:hover .tour-card__img { transform: scale(1.04); }

.tour-card__badge {
  position: absolute;
  top: .75rem;
  left: .75rem;
}

/* Body */
.tour-card__body {
  padding: 1rem 1rem .75rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: .4rem;
}

.tour-card__location {
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--primary);
  margin: 0;
}

.tour-card__title {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}
.tour-card__title a { color: var(--text-dark); }
.tour-card__title a:hover { color: var(--primary); }

.tour-card__pills {
  display: flex;
  flex-wrap: wrap;
  gap: .3rem;
}

.trust-badge { margin-top: .15rem; }

/* Footer */
.tour-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: .75rem 1rem;
  border-top: 1px solid var(--border);
  gap: .5rem;
}

.tour-card__price {
  display: flex;
  flex-direction: column;
  gap: .05rem;
}
.tour-card__price-label {
  font-size: .7rem;
  color: var(--text-muted);
}
.tour-card__price-value {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--accent-green);
  line-height: 1;
}
.tour-card__price small {
  font-size: .68rem;
  color: var(--text-muted);
}
</style>
